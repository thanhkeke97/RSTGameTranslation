<Window x:Class="RSTGameTranslation.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RSTGameTranslation"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_WindowTitle]}"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Icon="/media/AppIcon.ico">

    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemedComboBoxItem}"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PairButton" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="12,12,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="40" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/media/AppIcon.ico" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_WindowTitle]}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="14" Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse x:Name="circle" Fill="#FF5F57"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="circle" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,20,24,8">
                <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_Title]}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_Subtitle]}"/>

                <!-- Interface language -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_InterfaceLanguage]}"/>
                    <ComboBox x:Name="InterfaceLanguageComboBox" Width="180" SelectionChanged="InterfaceLanguageComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Game / target language -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_LanguagesTitle]}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_GameLanguage]}"/>
                                <ComboBox x:Name="SourceLanguageComboBox"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Bottom" Margin="12,0,12,2"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_TargetLanguage]}"/>
                                <ComboBox x:Name="TargetLanguageComboBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_CommonPairs]}"/>
                        <WrapPanel x:Name="CommonPairsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Current setup -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_ReadyTitle]}"/>
                        <TextBlock x:Name="ReadyText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- What to do next -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_NextTitle]}"/>
                        <TextBlock x:Name="NextStepsText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReopenHintText" Grid.Column="0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource NeutralButton}" Margin="0,0,8,0" Click="OpenSettingsButton_Click"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_Btn_OpenSettings]}"/>
                        <Button Style="{StaticResource AccentButton}" IsDefault="True" Click="GetStartedButton_Click"
                                Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[Welcome_Btn_GetStarted]}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
